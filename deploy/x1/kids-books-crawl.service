# X1 user unit: crawl ESTER, rebuild catalog.db, upload it to the droplet.
# Installed by deploy/x1/install.sh into ~/.config/systemd/user/.
[Unit]
Description=Kids Books: crawl ESTER and upload the catalogue
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/src/personal/kids-books
ExecStart=%h/src/personal/kids-books/deploy/x1/crawl-and-upload.sh
SuccessExitStatus=75
TimeoutStartSec=6h
Nice=10
